generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & Auth ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses            Address[]
  orders               Order[]
  wishlist             WishlistItem[]
  affiliateAccount     AffiliateAccount?
  affiliateApplication AffiliateApplication?
  auditLogs            AuditLog[]
}

enum UserRole {
  CUSTOMER
  AFFILIATE
  ADMIN
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  firstName  String
  lastName   String
  address1   String
  address2   String?
  city       String
  province   String
  postalCode String
  country    String   @default("CA")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  shortDescription String?
  description      String?
  category         ProductCategory @default(RESEARCH_PEPTIDE)
  researchCategory String?
  featured         Boolean         @default(false)
  isNew            Boolean         @default(false)
  published        Boolean         @default(false)
  imageUrl         String?
  metaTitle        String?
  metaDescription  String?
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variants      ProductVariant[]
  batches       ProductBatch[]
  coaDocuments  CoaDocument[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  articleLinks  ArticleProduct[]
}

enum ProductCategory {
  RESEARCH_PEPTIDE
  SUPPLY
  BUNDLE
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  sku            String   @unique
  price          Float
  compareAtPrice Float?
  concentration  String?
  size           String?
  stockQuantity  Int      @default(0)
  inStock        Boolean  @default(true)
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory[]
  orderItems OrderItem[]
}

model Inventory {
  id        String   @id @default(cuid())
  variantId String
  quantity  Int
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model ProductBatch {
  id             String    @id @default(cuid())
  productId      String
  batchNumber    String
  lotNumber      String?
  manufacturedAt DateTime?
  expiresAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  coaDocuments CoaDocument[]

  @@unique([productId, batchNumber])
}

// ─── COA Documents ────────────────────────────────────────────────────────────

model CoaDocument {
  id              String    @id @default(cuid())
  productId       String
  batchId         String?
  batchNumber     String
  lotNumber       String?
  testingDate     DateTime?
  testingProvider String?
  purityResult    String?
  resultSummary   String?
  documentUrl     String?
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   ProductBatch? @relation(fields: [batchId], references: [id])
}

// ─── Orders & Payments ────────────────────────────────────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  userId           String?
  email            String
  status           OrderStatus   @default(AWAITING_PAYMENT)
  paymentMethod    PaymentMethod @default(INTERAC_E_TRANSFER)
  subtotal         Float
  discountAmount   Float         @default(0)
  shippingAmount   Float         @default(0)
  taxAmount        Float         @default(0)
  total            Float
  currency         String        @default("CAD")
  discountCode     String?
  affiliateCode    String?
  affiliateId      String?
  referralCode     String?
  paymentReference String?
  shippingAddress  Json?
  billingAddress   Json?
  notes            String?
  trackingNumber   String?
  trackingCarrier  String?
  paidAt           DateTime?
  shippedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user       User?                @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  shipments  Shipment[]
  commission AffiliateCommission?
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  productName String
  variantName String
  sku         String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_RECEIVED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  INTERAC_E_TRANSFER
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  amount      Float
  method      PaymentMethod @default(INTERAC_E_TRANSFER)
  status      PaymentStatus @default(PENDING)
  reference   String?
  confirmedAt DateTime?
  confirmedBy String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  carrier        String?
  trackingNumber String?
  status         String    @default("pending")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType @default(PERCENTAGE)
  value          Float
  minOrderAmount Float?
  maxUses        Int?
  usedCount      Int          @default(0)
  active         Boolean      @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─── Affiliates ───────────────────────────────────────────────────────────────

model AffiliateApplication {
  id                     String                     @id @default(cuid())
  userId                 String?                    @unique
  name                   String
  firstName              String?
  lastName               String?
  email                  String
  phone                  String?
  address1               String?
  address2               String?
  city                   String?
  province               String?
  postalCode             String?
  country                String                     @default("Canada")
  canadianResident       Boolean                    @default(false)
  socialChannel          String?
  socialProfiles         Json?
  website                String?
  audienceSize           String?
  primaryPlatform        String?
  promotionPlan          String?
  whyAffiliate           String?
  affiliateStrengths     String?
  monthlyMinimumAccepted Boolean                    @default(false)
  complianceAccepted     Boolean                    @default(false)
  signedName             String?
  signedAt               DateTime?
  agreementVersion       String?
  status                 AffiliateApplicationStatus @default(PENDING)
  reviewedAt             DateTime?
  reviewedBy             String?
  reviewNotes            String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

enum AffiliateApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AffiliateAccount {
  id                       String          @id @default(cuid())
  userId                   String          @unique
  code                     String          @unique
  commissionRate           Float           @default(10)
  status                   AffiliateStatus @default(ACTIVE)
  totalClicks              Int             @default(0)
  totalOrders              Int             @default(0)
  totalEarnings            Float           @default(0)
  paidEarnings             Float           @default(0)
  pendingEarnings          Float           @default(0)
  missedMinimumMonths      Int             @default(0)
  minimumTrackingStartedAt DateTime        @default(now())
  frozenAt                 DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks       AffiliateClick[]
  attributions AffiliateAttribution[]
  commissions  AffiliateCommission[]
  payouts      AffiliatePayoutItem[]
  monthlyPerformance AffiliateMonthlyPerformance[]
}

model AffiliateMonthlyPerformance {
  id                 String   @id @default(cuid())
  affiliateId        String
  periodYear         Int
  periodMonth        Int
  qualifyingSales    Float    @default(0)
  commissionRate     Float    @default(10)
  commissionOwed     Float    @default(0)
  minimumMet         Boolean  @default(false)
  missedMinimumCount Int      @default(0)
  evaluatedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  affiliate AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

enum AffiliateStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  ipAddress   String?
  userAgent   String?
  referrer    String?
  landingPage String?
  createdAt   DateTime @default(now())

  affiliate AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model AffiliateAttribution {
  id          String   @id @default(cuid())
  affiliateId String
  sessionId   String?
  code        String
  ipAddress   String?
  expiresAt   DateTime
  converted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  affiliate AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model AffiliateCommission {
  id                   String           @id @default(cuid())
  affiliateId          String
  orderId              String           @unique
  orderNumber          String
  orderAmount          Float
  commissionableAmount Float
  commissionRate       Float
  commissionAmount     Float
  status               CommissionStatus @default(PENDING)
  flagged              Boolean          @default(false)
  flagReason           String?
  notes                String?
  approvedAt           DateTime?
  lockedAt             DateTime?
  paidAt               DateTime?
  reversedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  affiliate  AffiliateAccount     @relation(fields: [affiliateId], references: [id])
  order      Order                @relation(fields: [orderId], references: [id])
  payoutItem AffiliatePayoutItem?
}

enum CommissionStatus {
  PENDING
  APPROVED
  LOCKED
  PAID
  REVERSED
}

model AffiliatePayout {
  id          String       @id @default(cuid())
  periodMonth Int
  periodYear  Int
  status      PayoutStatus @default(DRAFT)
  totalAmount Float        @default(0)
  notes       String?
  processedAt DateTime?
  processedBy String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items AffiliatePayoutItem[]

  @@unique([periodYear, periodMonth])
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
}

model AffiliatePayoutItem {
  id               String                 @id @default(cuid())
  payoutId         String
  affiliateId      String
  commissionId     String?                @unique
  commissionIds    Json?
  grossSales       Float
  commissionRate   Float                  @default(10)
  reversals        Float                  @default(0)
  adjustments      Float                  @default(0)
  commissionOwed   Float
  status           PayoutStatus           @default(DRAFT)
  paymentReference String?
  paymentMethod    AffiliatePayoutMethod?
  paymentAmount    Float?
  paidBy           String?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  payout     AffiliatePayout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  affiliate  AffiliateAccount     @relation(fields: [affiliateId], references: [id])
  commission AffiliateCommission? @relation(fields: [commissionId], references: [id])
}

enum AffiliatePayoutMethod {
  E_TRANSFER
  CRYPTO
}

// ─── Content ──────────────────────────────────────────────────────────────────

model Article {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  excerpt         String?
  content         String
  category        ArticleCategory @default(PEPTIDES_101)
  author          String?
  readingTime     Int?
  published       Boolean         @default(false)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  products ArticleProduct[]
}

enum ArticleCategory {
  PEPTIDES_101
  RESEARCH_GUIDES
  LAB_TESTING
  COA_EDUCATION
  STORAGE_HANDLING
  INDUSTRY_EDUCATION
  CANADIAN_RESEARCH
}

model ArticleProduct {
  id        String @id @default(cuid())
  articleId String
  productId String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([articleId, productId])
}

model FaqItem {
  id        String      @id @default(cuid())
  question  String
  answer    String
  category  FaqCategory @default(GENERAL)
  sortOrder Int         @default(0)
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum FaqCategory {
  GENERAL
  SHIPPING
  PAYMENT
  PRODUCTS
  COA
  AFFILIATE
  RESEARCH
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  link      String?
  linkText  String?
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

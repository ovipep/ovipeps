{
  "name": "ovipeps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run test:shipping && npm run test:affiliates && npm run test:order-emails && npm run test:bulk-orders && npm run test:inventory && node scripts/apply-restock-migration.mjs",
    "test:shipping": "node --import tsx --test scripts/order-shipping.test.ts",
    "test:affiliates": "node --import tsx --test scripts/affiliate-payments.test.ts scripts/affiliate-profile.test.ts",
    "test:order-emails": "node --import tsx --test scripts/order-email-video.test.ts",
    "build": "prisma generate && node --import tsx scripts/prepare-bulk-recap.mts && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:bulk-orders": "node --import tsx --test scripts/bulk-checkout.test.ts",
    "test:inventory": "node --import tsx --test scripts/inventory-deletion.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "resend": "^6.22.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.6",
    "mysql2": "3.24.4"
  }
}
